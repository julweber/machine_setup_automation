# =============================================================================
# fail2ban jail.local — Auto-generated by setup-fail2ban.sh
# =============================================================================
# SSH port: ${FAIL2BAN_SSHD_PORT}
# Generated: ${GENERATED_DATE}
# =============================================================================

[sshd]
enabled = true
port = ${FAIL2BAN_SSHD_PORT},ssh
filter = sshd
logpath = /var/log/auth.log
maxretry = ${FAIL2BAN_MAXRETRY}
bantime = ${FAIL2BAN_BANTIME}
findtime = ${FAIL2BAN_FINDTIME}

[sshd-ddos]
enabled = true
port = ${FAIL2BAN_SSHD_PORT},ssh
filter = sshd-ddos
logpath = /var/log/auth.log
maxretry = 3
bantime = 1800
findtime = 60

[sshd-aggressive]
enabled = false
port = ${FAIL2BAN_SSHD_PORT},ssh
filter = sshd-aggressive
logpath = /var/log/auth.log
maxretry = 2
bantime = 86400
findtime = 300
banaction = ufw
