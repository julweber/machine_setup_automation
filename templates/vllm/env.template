# vLLM configuration — rendered by tasks/setup-vllm.sh
# Edit this file then restart the stack:  cd ${PROJECT_DIR} && docker compose up -d

# ── Model ────────────────────────────────────────────────────────────────────
# HuggingFace model ID (vLLM will fetch/use from the HF cache):
#   VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Path to an HF snapshot inside the container:
#   VLLM_MODEL=/root/.cache/huggingface/hub/models--Qwen--Qwen2.5-7B-Instruct/snapshots/latest
# Path to an LM Studio downloaded model (mounted at /lmstudio-models):
#   VLLM_MODEL=/lmstudio-models/lmstudio-community/Qwen2.5-7B-Instruct-GGUF
VLLM_MODEL=${VLLM_MODEL}

# ── HuggingFace token (leave empty if not needed) ────────────────────────────
HF_TOKEN=${HF_TOKEN}

# ── GPU memory utilization fraction (0.0–1.0) – ignored for CPU backend ──────
${VLLM_GPU_UTIL_NOTE}
VLLM_GPU_UTIL=${VLLM_GPU_UTIL}

# ── Model dtype: auto|bfloat16|float16|float32 ───────────────────────────────
# auto = let vLLM pick (bfloat16 for Ampere+, float16 for older NVIDIA / ROCm)
# Note: For FP8 quantization use VLLM_EXTRA_ARGS="--quantization fp8" instead.
# For pre-quantized NVFP4/FP8 checkpoints leave --quantization UNSET —
# vLLM detects the quantization from the model config automatically.
VLLM_DTYPE=${VLLM_DTYPE}

# ── Max context length (tokens) – leave empty to use the model's default ─────
# Reducing this lowers KV-cache memory usage significantly.
# Example: VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_MODEL_LEN=${VLLM_MAX_MODEL_LEN}

# ── Serving options (empty / false = vLLM default) ───────────────────────────
# Client-facing model ID (e.g. "local-model"); empty = served under VLLM_MODEL
VLLM_SERVED_MODEL_NAME=${VLLM_SERVED_MODEL_NAME}
# Trust remote code in the model repo (required for some models,
# e.g. Phi-4-multimodal): true|false
VLLM_TRUST_REMOTE_CODE=${VLLM_TRUST_REMOTE_CODE}
# Weight load format: auto|safetensors|fastsafetensors|gguf|...
# fastsafetensors cuts weight-load time on large models.
VLLM_LOAD_FORMAT=${VLLM_LOAD_FORMAT}
# Reasoning-parser for agent-ready serving (e.g. qwen3, nemotron_v3)
VLLM_REASONING_PARSER=${VLLM_REASONING_PARSER}
# Tool-call-parser for agent-ready serving (e.g. qwen3, qwen3_xml)
VLLM_TOOL_CALL_PARSER=${VLLM_TOOL_CALL_PARSER}
# Enable automatic tool choice: true|false
VLLM_ENABLE_AUTO_TOOL_CHOICE=${VLLM_ENABLE_AUTO_TOOL_CHOICE}

# ── Extra vLLM server arguments (space-separated, appended to the command) ───
# Examples:
#   --api-key secret123                  (enable API authentication)
#   --quantization awq                   (AWQ quantisation for memory savings)
#   --kv-cache-dtype fp8                 (FP8 KV cache – on DGX Spark only under
#                                         memory pressure; can hurt quality/speed)
#   --attention-backend <name>           (pin the attention backend)
#   --speculative-config <json>          (MTP speculative decoding)
# Prefix caching is ON by default in vLLM V1 — no flag needed.
VLLM_EXTRA_ARGS=${VLLM_EXTRA_ARGS}

# ── Concurrency tuning ───────────────────────────────────────────────────────
${VLLM_CONCURRENCY_NOTE}
VLLM_MAX_NUM_SEQS=${VLLM_MAX_NUM_SEQS}
VLLM_MAX_NUM_BATCHED_TOKENS=${VLLM_MAX_NUM_BATCHED_TOKENS}
