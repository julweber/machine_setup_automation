# =============================================================================
# Hermes Agent Environment Configuration
# =============================================================================
#
# This file contains sensitive keys and runtime configuration for Hermes Agent.
# It is mounted into the Docker container at /opt/data/.env
#
# IMPORTANT:
#   - NEVER commit this file to version control
#   - The API_SERVER_KEY is auto-generated on first install
#   - To change the API key, edit this file and restart the gateway
#
# =============================================================================

# -------------------------------------------------------
# OpenAI-Compatible API Server
# -------------------------------------------------------
# Enable the OpenAI-compatible HTTP API endpoint
API_SERVER_ENABLED=true

# Bind address (127.0.0.1 = localhost only, safe for local use)
# Set to 0.0.0.0 only if you need remote access (requires API_SERVER_KEY)
API_SERVER_HOST=127.0.0.1

# Port for the API server
API_SERVER_PORT=8642

# Bearer token for API authentication
# Auto-generated on first install. Change this to your own secret.
API_SERVER_KEY=change-me-local-dev

# Optional: Allow browser CORS origins (for direct browser access)
# Most frontends (Open WebUI, etc.) connect server-to-server and don't need this.
# API_SERVER_CORS_ORIGINS=http://localhost:3000

# -------------------------------------------------------
# Optional: OpenAI-compatible API Server (for external UIs)
# -------------------------------------------------------
# Uncomment and fill in if you want to use OpenAI API format
# API_SERVER_ENABLED=true
# API_SERVER_HOST=127.0.0.1
# API_SERVER_PORT=8642
# API_SERVER_KEY=<your-secret-key>

# -------------------------------------------------------
# Optional: Microsoft Teams Gateway
# -------------------------------------------------------
# Register your bot at https://dev.botframework.com/ to get these values.
# TEAMS_CLIENT_ID=<your-client-id>
# TEAMS_CLIENT_SECRET=<your-client-secret>
# TEAMS_TENANT_ID=<your-tenant-id>
# TEAMS_ALLOWED_USERS=<comma-separated list of allowed user IDs>
# TEAMS_PORT=3978
